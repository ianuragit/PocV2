    "@types/node": "24.19.2",
    "@types/three": "0.187.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
